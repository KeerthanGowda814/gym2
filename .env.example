# Apex Athletics Node.js Server Environment Configuration
PORT=5000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/gym2?retryWrites=true&w=majority

# EmailJS Configuration
EMAILJS_SERVICE_ID=service_example
EMAILJS_PUBLIC_KEY=public_key_example
EMAILJS_PRIVATE_KEY=private_key_example
EMAILJS_TEMPLATE_ID=template_example

# Google OAuth 2.0 Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
